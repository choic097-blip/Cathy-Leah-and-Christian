  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  textComponent: {fileID: 1104961449}
  lines:
  - null
  morning:
  - "Oh, hello. I\u2019m Nurman. Just a normal guy, doing normal things."
  - "Currently agonizing over what to get from this vending machine\u2026"
  afternoon:
  - "Standard choices are fine, but sometimes I crave something\u2026 unique."
  - Like that red drink over there.
  - I wonder what it tastes like?
  - '"Coke"? Never heard of it.'
  evening:
  - "It\u2019d be great if you could pick for me\u2026"
  - "but you don\u2019t have any coins, do you?"
  superLate:
  - What is the statistically optimal snack for a late-night craving?
  - Pancreas?
  textSpeed: 0.03
  theetime: {fileID: 2032897561}
  playerController: {fileID: 212614237}
  myDialBox: {fileID: 1040792365}
