  m_Script: {fileID: 11500000, guid: cf315fb13b2d44faca06b9437a6b860a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  textComponent: {fileID: 1104961449}
  lines:
  - null
  morning:
  - "Annyeonghasaeyo! I\u2019m Reah Rindy Rhin, the innkeeper."
  - "Don\u2019t ask for too many details\u2026 and don\u2019t forget to take a sip
    your welcome drink!"
  afternoon:
  - Have you talked to the guest on the second floor?
  - "They were mentioning a Yaoi artist named Arku\u2026"
  - "What\u2019s a \"Yaoi\"? I only know \"Oily Man.\""
  evening:
  - The sunbeds outside are the only beds we have.
  - I spent all the budget on buying the TV.
  superLate:
  - "This plant I\u2019m holding?"
  - Oh,
  - "It\u2019s just cannabis."
  textSpeed: 0.03
  theetime: {fileID: 2032897561}
  playerController: {fileID: 212614237}
  myDialBox: {fileID: 1040792365}
  blurFilter: {fileID: 245946042}
  characterUI: {fileID: 1557990393}
